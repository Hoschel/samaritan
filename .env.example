# Samaritan environment configuration
# Copy to .env. Core features and public data feeds start without API keys.

# Web UI host port
SAMARITAN_PORT=3000

# Internal web-app <-> RECON service secret. Replace before exposing the app.
# Generate a value with: openssl rand -hex 32
SCANNER_KEY=
# Local Node development ports. Compose overrides these with container DNS.
SCANNER_URL=http://localhost:4001
SCANNER_PORT=4001
SCANNER_HOST=127.0.0.1
INTEL_URL=http://localhost:4000
INTEL_HOST=127.0.0.1

# Ollama local inference (no API key or per-request cloud fee).
# Install Ollama on the host and pull a model, e.g. `ollama pull qwen3:4b`.
# Local Node development defaults to http://127.0.0.1:11434/v1 automatically.
# Docker Compose defaults to host.docker.internal; uncomment this only to override it:
# SAMARITAN_OLLAMA_URL=http://host.docker.internal:11434/v1
# For the optional Compose Ollama container, use instead:
# SAMARITAN_OLLAMA_URL=http://samaritan-ollama:11434/v1

# Optional Gemini free-tier key for built-in AI summary features.
# Keep the project/model within the provider's free tier and quota.
GEMINI_API_KEY_1=

# Optional free/public-source enhancements. The baseline app works without
# these; check provider rate limits, eligibility and terms before use.
CLOUDFLARE_API_TOKEN=
FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
N2YO_API_KEY=
AIS_API_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=

# Optional Shodan API key for richer passive indexed host records
# (service banners, product/version, CVEs and host metadata). Without it,
# Samaritan uses the free Shodan InternetDB index. Neither mode probes targets.
SHODAN_API_KEY=

# OI paid/BYOK providers are disabled by default. Set true only when you
# explicitly want visitors to connect their own paid-provider accounts.
# Visitors supply their own keys and may incur charges with those providers.
SAMARITAN_ALLOW_PAID_AI=false

# OpenRouter credentials are entered in the OI settings panel, not here.
# With paid AI disabled, only openrouter/free and models ending in :free work.

# Optional integrations; their routes remain disabled unless configured.
SDK_INGEST_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_FORWARD_URL=

# Optional comma-separated public Telegram usernames (without @).
# SAMARITAN_TELEGRAM_CHANNELS=

# Optional free transit feed keys (only for the operators you use).
# TRANSIT_WMATA_KEY=
# TRANSIT_511_KEY=
# TRANSIT_TRIMET_KEY=
# TRANSIT_TRANSLINK_KEY=
# TRANSIT_STM_KEY=
# TRANSIT_NTA_KEY=
# TRANSIT_TRAFIKLAB_KEY=
# TRANSIT_TFNSW_KEY=
# TRANSIT_METLINK_KEY=
# TRANSIT_AT_KEY=
